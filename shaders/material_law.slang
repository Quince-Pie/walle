// Chromatic tints: order 3 in the tint, 20 terms, in the
// same total-degree order as the transfer's basis.  Neutral tints are
// one-dimensional: order 4 in the tint's single level, 5 terms.
// Both bases run from the constant term upwards.  Each channel's base
// coefficients are followed by its beta and then its gamma.
//
// gamma - how much of the substrate's own chroma survives - is a
// fitted function of the tint wherever that beat pinning it.  Where
// pinning won, the pinned value is written into the CONSTANT term of
// the basis rather than branched on, so the shader has one path.
static const int kTintChromaticTermCount = 20;
static const int kTintNeutralTermCount = 5;

struct WalleTintRegime
{
    float chromaticBase[60];
    float chromaticBeta[60];
    float chromaticGamma[60];
    float neutralBase[15];
    float neutralBeta[15];
    float neutralGamma[15];
};

void walleTintBasis(float3 unit, out float terms[20])
{
    terms[0] = 1.0;
    terms[1] = unit.b;
    terms[2] = unit.g;
    terms[3] = unit.r;
    terms[4] = unit.b * unit.b;
    terms[5] = unit.g * unit.b;
    terms[6] = unit.g * unit.g;
    terms[7] = unit.r * unit.b;
    terms[8] = unit.r * unit.g;
    terms[9] = unit.r * unit.r;
    terms[10] = unit.b * unit.b * unit.b;
    terms[11] = unit.g * unit.b * unit.b;
    terms[12] = unit.g * unit.g * unit.b;
    terms[13] = unit.g * unit.g * unit.g;
    terms[14] = unit.r * unit.b * unit.b;
    terms[15] = unit.r * unit.g * unit.b;
    terms[16] = unit.r * unit.g * unit.g;
    terms[17] = unit.r * unit.r * unit.b;
    terms[18] = unit.r * unit.r * unit.g;
    terms[19] = unit.r * unit.r * unit.r;
}

void walleTintNeutralBasis(float level, out float terms[5])
{
    terms[0] = 1.0;
    terms[1] = level;
    terms[2] = level * level;
    terms[3] = level * level * level;
    terms[4] = level * level * level * level;
}

